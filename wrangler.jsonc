{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phsar-ichiba",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": false,
  "routes": [
    { "pattern": "phsarichiba.com", "custom_domain": true },
    { "pattern": "www.phsarichiba.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "phsar-ichiba",
      "database_id": "e345748c-f8c2-485a-afd8-e55cb354ef89",
      "migrations_dir": "drizzle/migrations",
      // `npm run dev` talks to the REAL production D1 so local and
      // phsarichiba.com share one database. Ignored on `wrangler deploy`.
      "remote": true
    }
  ],
  // Workers AI — powers the admin "Translate to English" button (src/data/translate.ts).
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    // Cross-site security dashboard ingest endpoint (see src/lib/audit.ts).
    // Not a secret, just a URL — the shared token is set via `wrangler secret put`.
    "SECURITY_EVENTS_URL": "https://todo-list-drab-ten.vercel.app/api/security-events"
  }
}
